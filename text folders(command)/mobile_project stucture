==================================
Step 5: Config File (wdio.conf.js)
==================================
javascript

export const config = {
    runner: 'local',
    specs: ['./tests/**/*.spec.js'],

    capabilities: [{
        platformName: 'Android',
        'appium:deviceName': 'emulator-5554',    // or real device name
        'appium:platformVersion': '13',
        'appium:app': './apps/your-app.apk',     // path to APK
        'appium:automationName': 'UiAutomator2',
        'appium:noReset': false,
        'appium:fullReset': false,
    }],

    services: ['appium'],

    framework: 'mocha',
    mochaOpts: {
        timeout: 120000
    },

    reporters: ['spec', ['allure', { outputDir: 'allure-results' }]],
};

