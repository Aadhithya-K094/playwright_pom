 Test File (
login.spec.js
)
javascript

import LoginPage from '../src/pages/LoginPage.js';
import { expect } from 'chai';

describe('Login Tests', () => {

    it('should login with valid credentials', async () => {
        await LoginPage.login('4028609', 'Test@123');

        // Verify navigation to home page
        const homeTitle = await $('~homeTitle');
        await homeTitle.waitForDisplayed({ timeout: 10000 });
        expect(await homeTitle.getText()).to.include('Dashboard');
    });

    it('should show error for invalid credentials', async () => {
        await LoginPage.login('invalid', 'wrong');

        const error = await LoginPage.getErrorText();
        expect(error).to.include('Invalid');
    });
});

=======
Step 8:
=======

 Finding Selectors (Appium Inspector)
Install Appium Inspector (GUI tool) to find element selectors:

Download: https://github.com/appium/appium-inspector/releases
Connect device/emulator
Start Appium server: appium
Open Inspector → connect → tap elements to get selectors
Selector types for Android:

Type	Example	When to use
Accessibility ID	$('~loginBtn')	Best — works cross-platform
Resource ID	$('//*[@resource-id="com.app:id/btn"]')	Most reliable for Android
XPath	$('//android.widget.Button[@text="Login"]')	Fallback
Class + Text	$('android=new UiSelector().text("Login")')	Android-specific

