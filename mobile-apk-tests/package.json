{
  "name": "tnemis-mobile-apk-tests",
  "version": "1.0.0",
  "description": "TN EMIS Mobile APK Automation Testing with Appium + WebdriverIO",
  "type": "module",
  "scripts": {
    "test": "npx wdio run config/wdio.conf.js",
    "test:login": "npx wdio run config/wdio.conf.js --spec tests/login.spec.js",
    "test:dashboard": "npx wdio run config/wdio.conf.js --spec tests/dashboard.spec.js",
    "appium:start": "appium",
    "appium:doctor": "appium-doctor --android",
    "report": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report"
  },
  "dependencies": {},
  "devDependencies": {
    "@wdio/cli": "^8.36.0",
    "@wdio/local-runner": "^8.36.0",
    "@wdio/mocha-framework": "^8.36.0",
    "@wdio/spec-reporter": "^8.36.0",
    "@wdio/allure-reporter": "^8.36.0",
    "@wdio/appium-service": "^8.36.0",
    "chai": "^5.1.0"
  }
}
